APP_NAME="PixFácil"
APP_ENV=production
APP_KEY=base64:8Rd6r0lp8YdGcw+vua5Glc/teTGEf+jbqJVIokkWyxQ=
APP_DEBUG=false
APP_URL=https://pixfacil.fun
ASSET_URL=https://pixfacil.fun
FRONTEND_URL=https://pixfacil.fun

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_LEVEL=error

# =========================================================
# BANCO DE DADOS - PREENCHA COM OS DADOS DA HOSTINGER
# =========================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u187586491_nomad
DB_USERNAME=u187586491_nomad
DB_PASSWORD=Pai91608820@

# Não use DATABASE_URL se estiver usando os campos DB_* acima.
DATABASE_URL=

# =========================================================
# SESSÃO / CACHE / FILAS
# =========================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.pixfacil.fun
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
CACHE_PREFIX=pixfacil

QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

FILESYSTEM_DISK=public
FILAMENT_FILESYSTEM_DISK=public

# =========================================================
# JWT
# Gere com: php artisan jwt:secret --force
# =========================================================
JWT_SECRET=8f4d2c9a71e63b50f4c82d193a7e6b2c9d5f1a8e4b7c6d3f2a91e58c7b4d6f3a
JWT_TTL=1440
JWT_REFRESH_TTL=20160
JWT_ALGO=HS256
JWT_BLACKLIST_ENABLED=true
JWT_BLACKLIST_GRACE_PERIOD=0

# =========================================================
# E-MAIL
# Pode deixar log enquanto não configurar SMTP.
# =========================================================
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS="no-reply@pixfacil.fun"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_NOTIFICATIONS_ENABLED=false

# =========================================================
# REDIS - DESATIVADO PARA HOSTINGER COMPARTILHADA
# =========================================================
REDIS_ENABLED=false
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =========================================================
# BROADCAST / PUSHER
# =========================================================
BROADCAST_CONNECTION=log

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"

# =========================================================
# META / PIXEL / CAPI - OPCIONAL
# =========================================================
META_CAPI_ENABLED=false
META_PIXEL_ID=
META_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# =========================================================
# WEBHOOK / GATEWAY - PREENCHA SOMENTE SE USAR
# Não coloque tokens reais em repositório público.
# =========================================================
XGATE_WEBHOOK_TOKEN=

# =========================================================
# SEGURANÇA / PRODUÇÃO
# =========================================================
ALLOW_ENV_EDIT=false
APP_DEMO=false
TRUSTED_PROXIES=*
CORS_ALLOWED_ORIGINS=https://pixfacil.fun,https://www.pixfacil.fun
ADMIN_PASSWORD_CONFIRM_MINUTES=30

# =========================================================
# CLOUDFLARE - OPCIONAL
# =========================================================
CLOUDFLARE_ENABLED=false

# =========================================================
# V14 - JOGOS RETRÔ
# O módulo usa as configurações armazenadas no banco/admin.
# Não são necessárias chaves adicionais aqui.
# =========================================================
